# Microgrid System Environment Variables
# Copy this file to .env and customize for your deployment

# Required for all deployments
GEMINI_API_KEY=your-gemini-api-key

# Authentication Mode: "local" for Keycloak, "cloud" for Google Cloud
AUTH_MODE=local

# OIDC Configuration
OIDC_AUDIENCE=microgrid-agents

# Local Mode (Keycloak) Configuration
# Use these when AUTH_MODE=local
OIDC_ISSUER=http://keycloak:8080/realms/microgrid
KEYCLOAK_REALM=microgrid
KEYCLOAK_CLIENT_ID=microgrid-agents
KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret

# Cloud Mode (Google Cloud) Configuration  
# Use these when AUTH_MODE=cloud
# OIDC_ISSUER=https://accounts.google.com
# GOOGLE_APPLICATION_CREDENTIALS=/app/creds/service-account.json

# Optional Configuration
TOKEN_CACHE_TTL=300
OIDC_KEY_CACHE_TTL=3600